{
  "manifest_version": 3,
  "name": "Void Galaxy",
  "version": "42.0",
  "description": "Cosmic new-tab audio-visual experience: galaxy visualizer for your music, with a subtle idle singularity state.",
  "permissions": [
    "storage",
    "tabs",
    "offscreen",
    "topSites",
    "favicon",
    "tabCapture",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "void-tab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Void Galaxy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*"
      ],
      "js": [
        "void-music-remote.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*"
      ],
      "js": [
        "void-media-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*"
      ],
      "js": [
        "void-media-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": [
        "notepad.html",
        "notepad.js",
        "icons/*",
        "data/quotes/*.json",
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "commands": {
    "vm-capture-tab": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Link this tab's audio to Void Music (live galaxy) — press again to stop"
    }
  }
}